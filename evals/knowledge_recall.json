{
  "description": "说明书检索召回评测集。expected 是可接受答案的集合（不是唯一答案），命中其中任意一条即算 top-1 正确。",
  "cases": [
    {
      "id": "ac-livingroom-not-cold",
      "query": "客厅空调开着但一点都不凉",
      "model": "SmartCool-AC2024",
      "expected": [
        "smartcool-ac2024-symptoms.md#制冷效果不佳"
      ],
      "kind": "colloquial",
      "note": "口语「不凉」对说明书书面语「制冷效果不佳」，词法零重叠"
    },
    {
      "id": "ac-livingroom-smell",
      "query": "客厅空调吹出来一股味儿",
      "model": "SmartCool-AC2024",
      "expected": [
        "smartcool-ac2024-symptoms.md#有异味"
      ],
      "kind": "colloquial",
      "note": "「一股味儿」要落到「有异味」，用户口语里不会出现「异」字"
    },
    {
      "id": "ac-livingroom-rattle",
      "query": "客厅空调一开就嗡嗡响还咔哒咔哒的",
      "model": "SmartCool-AC2024",
      "expected": [
        "smartcool-ac2024-symptoms.md#噪音异常"
      ],
      "kind": "colloquial",
      "note": "拟声词「嗡嗡」「咔哒」要落到「噪音异常」，查询里没有「噪音」二字"
    },
    {
      "id": "ac-bedroom-still-hot",
      "query": "卧室空调开半天屋里还是热得不行",
      "model": "FrostLine-AC310",
      "expected": [
        "frostline-ac310-symptoms.md#制冷效果不佳"
      ],
      "kind": "colloquial",
      "note": "用体感「热」描述制冷不足；同名小节两台空调都有，同时考型号过滤"
    },
    {
      "id": "ac-bedroom-dripping",
      "query": "卧室空调往下滴水把地板都弄湿了",
      "model": "FrostLine-AC310",
      "expected": [
        "frostline-ac310-symptoms.md#排水不畅",
        "frostline-ac310-maintenance.md#冷凝水管检查"
      ],
      "kind": "colloquial",
      "note": "「滴水」对「排水不畅」；冷凝水管检查讲的是同一根因，也算合理答案"
    },
    {
      "id": "ac-bedroom-frozen",
      "query": "卧室空调出风口那儿冻上了有一层冰",
      "model": "FrostLine-AC310",
      "expected": [
        "frostline-ac310-symptoms.md#蒸发器结霜"
      ],
      "kind": "colloquial",
      "note": "用户只会说「冻上了/结冰」，说明书写「蒸发器结霜」"
    },
    {
      "id": "tv-buffering-spin",
      "query": "客厅电视看剧老是转圈圈卡住",
      "model": "VisionTV-V1",
      "expected": [
        "visiontv-v1-symptoms.md#网络视频频繁缓冲"
      ],
      "kind": "colloquial",
      "note": "「转圈圈」是加载动画的口语说法，说明书写「缓冲」"
    },
    {
      "id": "tv-back-hot",
      "query": "客厅电视后背摸着挺烫的正常吗",
      "model": "VisionTV-V1",
      "expected": [
        "visiontv-v1-maintenance.md#散热与固件维护"
