# ============================================================================
# 智能家居 Agent 统一环境变量配置文件
# ============================================================================
# 复制为 .env 并填入真实的 API 密钥
# 支持两种命名风格（通用名优先）:

# ============================================================================
# 🚀 通用 LLM 配置（推荐，自动兼容多种 LLM 提供商）
# ============================================================================

# 模型名称（qwen-plus / qwen-max / qwen3.7-plus 等）
LLM_MODEL_ID=qwen-plus

# API 密钥
LLM_API_KEY=sk-your-api-key-here

# 服务地址（阿里百炼 / 阿里云 MaaS）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 超时秒数（可选，默认 60）
LLM_TIMEOUT=60

# ============================================================================
# 🔧 百炼专用名（备选，通用名不存在时使用）
# ============================================================================
# BAILIAN_API_KEY=sk-your-api-key-here
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen-plus

# ============================================================================
# 📝 日志
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# 🔌 MCP 服务器
# ============================================================================
MCP_SERVER_ENABLED=true
MCP_SERVER_PORT=8765

# ============================================================================
# 🔗 外部 MCP 服务（可选）
# ============================================================================
# 格式: {"name":"weather","transport":"stdio","command":"python","args":["server.py"]}
EXTERNAL_MCP_SERVERS=

# ============================================================================
# 💾 记忆
# ============================================================================
# SQLite 持久化数据库路径（留空则使用内存模式）
CHECKPOINT_DB_PATH=data/checkpoints.db
# 结构化长期记忆（阶段二）
ENABLE_LONG_TERM_MEMORY=true
CHECKPOINT_LONG_TERM_DB_PATH=data/memories.db
# 阶段三：上下文窗口与保留策略
CHECKPOINT_CONTEXT_MAX_MESSAGES=12
CHECKPOINT_CONTEXT_MAX_TOKENS=2400
CHECKPOINT_TOOL_RESULT_MAX_CHARS=1200
CHECKPOINT_SUMMARY_MAX_CHARS=1800
CHECKPOINT_SESSION_TTL_HOURS=168

# 阶段七：Planner–Executor–Verifier
PLANNING_ENABLED=true
PLANNING_MAX_STEPS=8
PLANNING_MAX_STEP_RETRIES=1
PLANNING_MAX_REPLANS=1

# 阶段八：结构化意图路由
ROUTING_ENABLED=true
ROUTING_CONFIDENCE_THRESHOLD=0.6

# 阶段十：Supervisor 与专用 Agent
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_HANDOFFS=2

# CLI/API 请求身份由业务后端提供；以下是本地运行示例：
# python -m src.main --home-id demo-home --user-id user-001 \
#   --session-id session-001 --client-id phone-001 --room-id living_room
