# ============================================================================
# 智能家居 Agent 统一环境变量配置文件
# ============================================================================
# 复制为 .env 并填入真实的 API 密钥
# 支持两种命名风格（通用名优先）:

# ============================================================================
# 🚀 通用 LLM 配置（推荐，自动兼容多种 LLM 提供商）
# ============================================================================

# 模型名称（qwen-plus / qwen-max / qwen3.7-plus 等）
LLM_MODEL_ID=qwen-plus

# API 密钥
LLM_API_KEY=sk-your-api-key-here

# 服务地址（阿里百炼 / 阿里云 MaaS）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 超时秒数（可选，默认 60）
LLM_TIMEOUT=60

# ============================================================================
# 🔧 百炼专用名（备选，通用名不存在时使用）
# ============================================================================
# BAILIAN_API_KEY=sk-your-api-key-here
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen-plus

# ============================================================================
# 📝 日志
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# 🔌 MCP 服务器
# ============================================================================
MCP_SERVER_ENABLED=true
MCP_SERVER_PORT=8765

# ============================================================================
# 🔗 外部 MCP 服务（可选）
# ============================================================================
# 本地天气 MCP：`python` 会自动解析为启动主 Agent 的同一个解释器
EXTERNAL_MCP_SERVERS=[{"name":"weather","transport":"stdio","command":"python","args":["-m","src.mcp.weather_server"]}]

# 默认城市可留空；留空时需要在问题中明确城市，例如“杭州今天天气怎么样”
WEATHER_DEFAULT_LOCATION=

# 彩云天气 token（必填，否则天气工具会返回未配置提示）
# 领取地址：https://dashboard.caiyunapp.com
# 城市名到坐标仍由免费的 Open-Meteo geocoding 完成，无需额外 Key
CAIYUN_WEATHER_TOKEN=

# ============================================================================
# 💾 记忆
# ============================================================================
# SQLite 持久化数据库路径（留空则使用内存模式）
CHECKPOINT_DB_PATH=data/checkpoints.db
# 结构化长期记忆（阶段二）
ENABLE_LONG_TERM_MEMORY=true
CHECKPOINT_LONG_TERM_DB_PATH=data/memories.db
# 阶段三：上下文窗口与保留策略
CHECKPOINT_CONTEXT_MAX_MESSAGES=12
CHECKPOINT_CONTEXT_MAX_TOKENS=2400
CHECKPOINT_TOOL_RESULT_MAX_CHARS=1200
CHECKPOINT_SUMMARY_MAX_CHARS=1800
CHECKPOINT_SESSION_TTL_HOURS=168

# 阶段七：Planner–Executor–Verifier
PLANNING_ENABLED=true
PLANNING_MAX_STEPS=8
PLANNING_MAX_STEP_RETRIES=1
PLANNING_MAX_REPLANS=1

# 阶段八：结构化意图路由
ROUTING_ENABLED=true
ROUTING_CONFIDENCE_THRESHOLD=0.6

# 阶段十：Supervisor 与专用 Agent
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_HANDOFFS=2

# 阶段十二：本地 Agentic RAG
RAG_ENABLED=true
RAG_KNOWLEDGE_PATH=docs/knowledge
RAG_TOP_K=3
RAG_MAX_REWRITES=1

# 013：混合检索（BM25 词法通道 + 向量语义通道，RRF 融合名次）
# 两个通道的权重。任一个设为 0 表示该通道完全不参与（可用来做消融实验）。
# 不要为了召回率把 BM25 权重清零：实测纯向量的 Recall@3/MRR 更好，
# 但 embedding 一挂就全部拒答，而且"这份说明书没讲这件事"只有词法通道说得出来。
RAG_BM25_WEIGHT=0.5
RAG_DENSE_WEIGHT=0.5

# 命中准入的两档分数下限，实测标定（`python -m src.evaluation.recall --sweep`）。
# 换语料或换 embedding 模型后必须重标，照抄旧值会让拒答纪律静默失效。
RAG_MIN_SCORE=0.35
RAG_REWRITTEN_MIN_SCORE=0.42

# 引用精度的相对截断：置信度不到第一名这个比例的候选不进引用。
# 管的是"同一份手册的兄弟小节一起被召回"——同一台电器的不同症状语义本来就近，
# 靠提高绝对下限解决会连正确答案一起砍掉。第一名永远保留，所以它不会把能答的变成拒答。
RAG_RELATIVE_FLOOR=0.7

# 语义通道。留空 RAG_EMBEDDING_MODEL_ID 即关闭，检索退化为纯 BM25（会打 INFO 日志）。
# 地址与 Key 留空时回落到上面的 LLM_BASE_URL / LLM_API_KEY——多数部署里
# embedding 和对话模型在同一个 OpenAI 兼容端点上。
# 向量按内容哈希缓存到 RAG_EMBEDDING_CACHE_PATH，改说明书才重算，不是每次检索都联网。
RAG_EMBEDDING_MODEL_ID=text-embedding-v4
# RAG_EMBEDDING_BASE_URL=
# RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_CACHE_PATH=data/embeddings

# 阶段十三：事件驱动自动化例程
AUTOMATION_ENABLED=true
AUTOMATION_DB_PATH=data/automation.db
AUTOMATION_TIMEZONE=Asia/Shanghai
AUTOMATION_POLL_SECONDS=1

# CLI/API 请求身份由业务后端提供；以下是本地运行示例：
# python -m src.main --home-id demo-home --user-id user-001 \
#   --session-id session-001 --client-id phone-001 --room-id living_room
